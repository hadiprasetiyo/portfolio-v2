# ============================================================
# Express API Server
# ============================================================

# Port untuk Express API server (default: 3001)
PORT=3001

# Environment: development | production
NODE_ENV=development

# ============================================================
# Resend — Email Provider
# Daftar gratis di: https://resend.com
# ============================================================

# API Key dari: resend.com → API Keys → Create API Key
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# ─── CONTACT_TO_EMAIL — Inbox penerima pesan ─────────────────────────────────
# Email yang akan menerima pesan dari form Contact.
#
# ⚠️  PENTING saat menggunakan onboarding@resend.dev (development):
#    Email hanya bisa dikirim ke alamat email yang terdaftar di akun Resend Anda.
#    Isi dengan email yang sama yang Anda gunakan saat daftar di resend.com.
#
CONTACT_TO_EMAIL=email_akun_resend_anda@gmail.com

# ─── CONTACT_FROM_EMAIL — Alamat pengirim ────────────────────────────────────
# Untuk DEVELOPMENT (tanpa domain sendiri):
#   Biarkan baris ini dikomentari atau hapus.
#   Server akan otomatis menggunakan: onboarding@resend.dev
#   (hanya bisa mengirim ke email akun Resend Anda — lihat CONTACT_TO_EMAIL)
#
# Untuk PRODUCTION (sudah punya domain terverifikasi di Resend):
#   Aktifkan baris di bawah dan ganti dengan domain Anda.
#
# CONTACT_FROM_EMAIL=noreply@yourdomain.com
